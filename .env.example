# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente no servidor — usada para criar usuários (equipe/clientes). Nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do site (usada nos links de RSVP enviados por WhatsApp)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Número de WhatsApp da ArtBrown (somente dígitos, com DDI) — botão do site
NEXT_PUBLIC_WHATSAPP_NUMBER=5511999999999
